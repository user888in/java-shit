# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=real_estate_agent

# Redis Configuration (for Bull queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Configuration
EMAIL_SERVICE=smtp  # Options: smtp, sendgrid, gmail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
EMAIL_FROM=noreply@realestateagent.com

# Optional: SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Optional: Gmail Configuration
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# LinkedIn API Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Application Configuration
PORT=3000
NODE_ENV=development

# Feature Flags
ENABLE_PROSPECTING=true
ENABLE_RESEARCH=true
ENABLE_OUTREACH=true